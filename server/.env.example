# Server
PORT=5000
NODE_ENV=development

# Database (MySQL-compatible — configured here for TiDB Cloud)
# Get these from TiDB Cloud → your cluster → Connect
DB_HOST=gateway01.xx-xxxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxxxxxx.root
DB_PASSWORD=yourpassword
DB_NAME=budgetwise
DB_SSL=true

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - your deployed frontend URL
CLIENT_URL=http://localhost:5173

